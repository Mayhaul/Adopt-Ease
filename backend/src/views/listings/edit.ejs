<%- layout('layouts/boilerplate') %>

<section class="form-section">

    <div class="form-container">

        <h1>Edit Pet Listing</h1>
        <p>Update the information about your pet.</p>

        <form
            action="/listings/<%= listing._id %>?_method=PUT"
            method="POST"
        >

            <div class="form-group">
                <label>Pet Name</label>
                <input
                    type="text"
                    name="name"
                    value="<%= listing.name %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Species</label>
                <select name="species" required>
                    <% ['Dog', 'Cat', 'Bird', 'Rabbit', 'Other'].forEach(s => { %>
                        <option value="<%= s %>" <%= listing.species === s ? 'selected' : '' %>>
                            <%= s %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label>Breed</label>
                <input
                    type="text"
                    name="breed"
                    value="<%= listing.breed %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Age</label>
                <input
                    type="number"
                    name="age"
                    min="0"
                    value="<%= listing.age %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Gender</label>
                <select name="gender" required>
                    <% ['Male', 'Female', 'Unknown'].forEach(g => { %>
                        <option value="<%= g %>" <%= listing.gender === g ? 'selected' : '' %>>
                            <%= g %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label>Location</label>
                <input
                    type="text"
                    name="location"
                    value="<%= listing.location %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Image URL</label>
                <input
                    type="url"
                    name="image"
                    value="<%= listing.images?.[0] || '' %>"
                >
            </div>

            <div class="form-group">
                <label>Health Status</label>
                <input
                    type="text"
                    name="healthStatus"
                    value="<%= listing.healthStatus || '' %>"
                >
            </div>

            <div class="form-group">
                <label>Vaccinated?</label>
                <select name="vaccinationStatus">
                    <option value="false" <%= !listing.vaccinationStatus ? 'selected' : '' %>>
                        No
                    </option>
                    <option value="true" <%= listing.vaccinationStatus ? 'selected' : '' %>>
                        Yes
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea
                    name="description"
                    rows="5"
                    required
                ><%= listing.description %></textarea>
            </div>

            <button type="submit" class="btn-primary">
                Save Changes
            </button>

            <a href="/listings/<%= listing._id %>" class="btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</section>