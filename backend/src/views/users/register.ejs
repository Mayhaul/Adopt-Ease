<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adopt-Ease | Register</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="navbar">
        <a href="/" class="logo">🐾 Adopt-Ease</a>
        <nav>
            <a href="/">Home</a>
            <a href="/listings">Animal Listings</a>
            <a href="/user/login">Login</a>
        </nav>
    </header>
    <main>
        <section class="section form-section">
            <div class="section-heading">
                <p class="eyebrow">JOIN OUR COMMUNITY</p>
                <h1>Create Your Account</h1>
                <p>Join Adopt-Ease and help animals find their forever homes.</p>
            </div>
            <form action="/user/register" method="POST" class="dog-form">
                <div class="form-grid">
                    <div class="field">
                        <label for="username">Full Name</label>
                        <input type="text" id="username" name="username" placeholder="Enter your name" minlength="3" required>
                    </div>
                    <div class="field">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required>
                    </div>
                    <div class="field">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" placeholder="Enter phone number" required>
                    </div>
                    <div class="field">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Create a password" minlength="8" required>
                    </div>
                </div>
                <div class="field">
                    <label for="address">Address</label>
                    <textarea id="address" name="address" rows="3" placeholder="Enter your city and address" required></textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" class="primary-btn">Create Account</button>
                </div>
                <p class="auth-switch">Already have an account? <a href="/user/login">Login here</a></p>
            </form>
        </section>
    </main>
    <footer>
        <strong>🐾 Adopt-Ease</strong>
        <p>Helping animals find loving homes.</p>
    </footer>
</body>
</html>
