<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Adopt-Ease | Login</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header class="navbar">
        <a href="/" class="logo">🐾 Adopt-Ease</a>

        <nav>
            <a href="/">Home</a>
            <a href="/listings">Animal Listings</a>
            <a href="/user/register">Register</a>
        </nav>
    </header>

    <main>

        <section class="section form-section">

            <div class="section-heading">
                <p class="eyebrow">WELCOME BACK</p>

                <h1>Login to Adopt-Ease</h1>

                <p>
                    Sign in to manage your listings and
                    track your adoption applications.
                </p>
            </div>

            <form action="/login" method="POST" class="dog-form">

                <div class="field">
                    <label for="email">Email Address</label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="you@example.com"
                        required
                    >
                </div>

                <div class="field">
                    <label for="password">Password</label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        required
                    >
                </div>

                <div class="form-actions">

                    <button type="submit" class="primary-btn">
                        Login
                    </button>

                </div>

                <p class="auth-switch">
                    Don't have an account?
                    <a href="/register">Create an account</a>
                </p>

            </form>

        </section>

    </main>

    <footer>
        <strong>🐾 Adopt-Ease</strong>
        <p>Helping animals find loving homes.</p>
    </footer>

</body>
</html>
