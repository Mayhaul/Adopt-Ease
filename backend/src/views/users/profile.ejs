<%- layout('layouts/boilerplate') %>

<section class="listings-section">
    <div class="container">

        <div class="section-heading">
            <h1>
                Welcome, <%= user.displayName || user.email %>!
            </h1>

            <p>Manage your account and adoption activities.</p>
        </div>

        <div class="profile-card">

            <div class="profile-avatar">
                🐾
            </div>

            <div class="profile-details">

                <h2><%= user.displayName || 'Adopt-Ease Member' %></h2>

                <p><%= user.email %></p>

                <p><%= user.phone %></p>

                <p><%= user.address %></p>

                <span class="role-badge">
                    <%= user.role %>
                </span>

            </div>

        </div>

        <div class="dashboard-grid">

            <a href="/listings/my-listings" class="dashboard-card">
                <span>🏠</span>
                <h3>My Listings</h3>
                <p>Manage your pet listings.</p>
            </a>

            <a href="/adoptions/my-applications" class="dashboard-card">
                <span>📋</span>
                <h3>My Applications</h3>
                <p>Track your adoption applications.</p>
            </a>

            <a href="/adoptions/received" class="dashboard-card">
                <span>🐾</span>
                <h3>Received Applications</h3>
                <p>Review applications for your pets.</p>
            </a>

            <a href="/listings/new" class="dashboard-card">
                <span>➕</span>
                <h3>Create Listing</h3>
                <p>List a new pet for adoption.</p>
            </a>

        </div>

    </div>
</section>